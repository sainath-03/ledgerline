# --- Database (Neon Postgres, connected via Vercel Storage) ---
# Whichever connection-string env var your Postgres integration
# actually created — lib/db.js checks NEON_POSTGRES_URL first, then
# falls back to POSTGRES_URL / NEON_DATABASE_URL / DATABASE_URL.
# You usually don't set this by hand; Vercel injects it once the
# database is connected to the project (Storage tab).
NEON_POSTGRES_URL=

# --- Sign-in (Google, via NextAuth) ---
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth client ID (type: Web application)
# 3. Add an Authorized redirect URI for each place you run this app:
#      https://<your-vercel-domain>/api/auth/callback/google
#      http://localhost:3000/api/auth/callback/google   (for local dev)
# 4. Copy the client ID and secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret NextAuth uses to sign session cookies. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Email (sent via your own Gmail account) ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose app "Mail", device "Other" -> name it "Ledgerline")
# 3. Paste the 16-character app password below (no spaces needed either way).
# This is the account Ledgerline SENDS from — every signed-in user
# gets emailed at their own Google account address automatically, so
# you don't set a recipient here anymore.
GMAIL_USER=sainathreddy.mittu@gmail.com
GMAIL_APP_PASSWORD=

# --- Cron protection ---
# Any random string. Vercel Cron sends this back as a Bearer token so
# randoms on the internet can't trigger your email endpoint. Generate one
# with: openssl rand -hex 32
CRON_SECRET=
